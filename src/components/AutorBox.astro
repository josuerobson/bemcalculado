---
interface Props {
  autor?: string;
  atualizacao: string;
  fontes?: Array<{ nome: string; url: string }>;
}

const { autor = '[Nome do autor]', atualizacao, fontes } = Astro.props;
---

<aside class="autor-box">
  <div class="autor-box__header">
    <div class="autor-box__avatar" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
    </div>
    <div>
      <p class="autor-box__name">{autor}</p>
      <p class="autor-box__date">Atualizado em {atualizacao}</p>
    </div>
  </div>
  <a href="/metodologia" class="autor-box__link">
    Ver nossa metodologia
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
  </a>
  {fontes && fontes.length > 0 && (
    <div class="autor-box__fontes">
      <p class="autor-box__fontes-title">Fontes</p>
      <ul>
        {fontes.map((f) => (
          <li><a href={f.url} target="_blank" rel="noopener noreferrer">{f.nome}</a></li>
        ))}
      </ul>
    </div>
  )}
</aside>

<style>
  .autor-box {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    margin-top: 1.5rem;
    font-size: 0.8125rem;
    box-shadow: var(--shadow-sm);
  }

  .autor-box__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .autor-box__avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .autor-box__name {
    color: var(--text-primary);
    font-weight: 600;
    margin: 0;
    font-size: 0.875rem;
  }

  .autor-box__date {
    color: var(--text-muted);
    margin: 0.125rem 0 0;
  }

  .autor-box__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .autor-box__link:hover { text-decoration: underline; }

  .autor-box__fontes {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .autor-box__fontes-title {
    color: var(--text-muted);
    margin: 0 0 0.375rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.6875rem;
  }

  .autor-box__fontes ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .autor-box__fontes a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .autor-box__fontes a:hover {
    color: var(--accent);
  }
</style>
