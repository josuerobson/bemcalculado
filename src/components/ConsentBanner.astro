---
---

<div class="consent-banner" id="consent-banner" style="display:none;">
  <div class="consent-banner__inner">
    <p class="consent-banner__text">
      Utilizamos cookies para melhorar sua experiência e exibir anúncios relevantes.
      <a href="/politica-de-privacidade">Saiba mais</a>
    </p>
    <div class="consent-banner__actions">
      <button id="consent-accept" class="consent-banner__btn consent-banner__btn--primary">Aceitar</button>
      <button id="consent-reject" class="consent-banner__btn consent-banner__btn--secondary">Rejeitar</button>
    </div>
  </div>
</div>

<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(...args: any[]) {
    window.dataLayer.push(args);
  }

  gtag('consent', 'default', {
    analytics_storage: 'denied',
    ad_storage: 'denied',
  });

  const STORAGE_KEY = 'bemcalculado-consent';

  document.addEventListener('DOMContentLoaded', () => {
    const banner = document.getElementById('consent-banner');
    const stored = localStorage.getItem(STORAGE_KEY);

    if (!stored) {
      banner!.style.display = '';
    }

    document.getElementById('consent-accept')?.addEventListener('click', () => {
      localStorage.setItem(STORAGE_KEY, 'granted');
      banner!.style.display = 'none';
      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          analytics_storage: 'granted',
          ad_storage: 'granted',
        });
      }
    });

    document.getElementById('consent-reject')?.addEventListener('click', () => {
      localStorage.setItem(STORAGE_KEY, 'denied');
      banner!.style.display = 'none';
    });
  });
</script>

<style>
  .consent-banner {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    z-index: 1000;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .consent-banner__inner {
    pointer-events: auto;
    max-width: 640px;
    width: 100%;
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    backdrop-filter: blur(8px);
  }

  .consent-banner__text {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin: 0;
    flex: 1;
    min-width: 200px;
    line-height: 1.5;
  }

  .consent-banner__text a {
    color: var(--accent);
    text-decoration: underline;
  }

  .consent-banner__actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .consent-banner__btn {
    font-size: 0.8125rem;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius);
    border: none;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.2s;
  }

  .consent-banner__btn--primary {
    background: var(--accent);
    color: #fff;
  }

  .consent-banner__btn--primary:hover {
    background: var(--accent-hover);
  }

  .consent-banner__btn--secondary {
    background: transparent;
    color: var(--text-secondary);
    border: 1.5px solid var(--border);
  }

  .consent-banner__btn--secondary:hover {
    border-color: var(--accent-border);
    color: var(--accent);
  }
</style>
