---
import CalculadoraLayout from '../../layouts/CalculadoraLayout.astro';
import AutorBox from '../../components/AutorBox.astro';
import ResultadoBox from '../../components/ResultadoBox.astro';
import CalcCard from '../../components/CalcCard.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Simulador de Financiamento",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "BRL"
  }
};
---

<CalculadoraLayout
  title="Simulador de Financiamento — Bem Calculado"
  description="Simule seu financiamento nos sistemas SAC e Tabela Price. Veja parcelas, total pago, juros e evolução mês a mês. Grátis e sem cadastro."
  canonical="https://bemcalculado.com.br/calculadoras/simulador-de-financiamento/"
  atualizacao="2026-06-28"
  breadcrumbItems={[
    { label: 'Início', href: '/' },
    { label: 'Calculadoras', href: '/' },
    { label: 'Simulador de Financiamento' }
  ]}
  jsonLd={jsonLd}
>
  <h1>Simulador de Financiamento</h1>

  <p class="intro">
    Compare os sistemas de amortização SAC e Tabela Price para seu financiamento.
    Descubra o valor das parcelas, o total de juros e acompanhe a evolução mês a mês.
  </p>

  <AutorBox
    autor="Josué R M de Souza"
    atualizacao="28 de junho de 2026"
    fontes={[{ nome: 'Banco Central do Brasil', url: 'https://www.bcb.gov.br/' }]}
  />

  <form id="form-financiamento" class="calc-form" novalidate>
    <div class="form-group">
      <label for="valor-bem">Valor do bem (R$)</label>
      <span class="hint">Valor total do imóvel, veículo ou bem a ser financiado.</span>
      <input type="text" id="valor-bem" inputmode="decimal" placeholder="300.000,00" aria-describedby="erro-valor-bem" />
      <span class="erro" id="erro-valor-bem" role="alert"></span>
    </div>

    <div class="form-group">
      <label for="entrada">Entrada (R$)</label>
      <span class="hint">Valor pago como entrada (pode ser zero).</span>
      <input type="text" id="entrada" inputmode="decimal" placeholder="60.000,00" aria-describedby="erro-entrada" />
      <span class="erro" id="erro-entrada" role="alert"></span>
    </div>

    <div class="form-group">
      <label for="taxa-juros">Taxa de juros anual (%)</label>
      <span class="hint">Taxa nominal anual do financiamento, ex: 10 para 10% a.a.</span>
      <input type="text" id="taxa-juros" inputmode="decimal" placeholder="10" aria-describedby="erro-taxa-juros" />
      <span class="erro" id="erro-taxa-juros" role="alert"></span>
    </div>

    <div class="form-group">
      <label for="prazo">Prazo (meses)</label>
      <span class="hint">Quantidade de parcelas do financiamento.</span>
      <input type="number" id="prazo" min="1" placeholder="360" aria-describedby="erro-prazo" />
      <span class="erro" id="erro-prazo" role="alert"></span>
    </div>

    <div class="form-group">
      <label>Sistema de amortização</label>
      <span class="hint">SAC tem parcelas decrescentes; Price tem parcelas fixas.</span>
      <div class="pill-toggle">
        <input type="radio" id="sistema-sac" name="sistema" value="sac" checked />
        <label for="sistema-sac">SAC</label>
        <input type="radio" id="sistema-price" name="sistema" value="price" />
        <label for="sistema-price">Tabela Price</label>
      </div>
    </div>

    <button type="submit" class="btn-primary">Simular</button>
  </form>

  <ResultadoBox>
    <div id="resultado-principal" style="display:none;">
      <p class="label">Valor da Primeira Parcela</p>
      <p class="valor" id="valor-primeira-parcela"></p>
    </div>

    <div id="resultado-detalhes" style="display:none;">
      <table class="tabela-resumo">
        <tbody>
          <tr>
            <td class="label">Valor da Primeira Parcela</td>
            <td class="tabela-valor" id="detalhe-primeira-parcela"></td>
          </tr>
          <tr>
            <td class="label">Valor da Última Parcela</td>
            <td class="tabela-valor" id="detalhe-ultima-parcela"></td>
          </tr>
          <tr>
            <td class="label">Total Pago</td>
            <td class="tabela-valor" id="detalhe-total-pago"></td>
          </tr>
          <tr>
            <td class="label">Total de Juros</td>
            <td class="tabela-valor" id="detalhe-total-juros"></td>
          </tr>
        </tbody>
      </table>
    </div>

    <details id="tabela-evolucao" style="display:none;">
      <summary>Ver evolução mês a mês</summary>
      <div class="tabela-scroll">
        <table id="tabela-mensal">
          <thead>
            <tr>
              <th>Mês</th>
              <th>Amortização</th>
              <th>Juros</th>
              <th>Parcela</th>
              <th>Saldo Devedor</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </details>
  </ResultadoBox>

  <div class="acoes" style="display:none;" id="acoes-resultado">
    <button type="button" class="btn-secondary" id="btn-compartilhar">Compartilhar resultado</button>
    <button type="button" class="btn-secondary" id="btn-imprimir">Imprimir</button>
  </div>

  <section class="como-calculamos">
    <h2>Como calculamos</h2>

    <h3>Tabela Price (parcelas fixas)</h3>
    <p>A parcela fixa é calculada pela fórmula:</p>
    <p class="formula">
      PMT = PV &times; [i&middot;(1+i)<sup>n</sup>] / [(1+i)<sup>n</sup> &minus; 1]
    </p>
    <p>Onde:</p>
    <ul>
      <li><strong>PV</strong> = Valor financiado (valor do bem menos a entrada)</li>
      <li><strong>i</strong> = Taxa de juros mensal</li>
      <li><strong>n</strong> = Número de parcelas</li>
    </ul>

    <h3>SAC (parcelas decrescentes)</h3>
    <p>A amortização é fixa e os juros são calculados sobre o saldo devedor:</p>
    <p class="formula">
      Amortização = PV / n<br />
      Juros<sub>k</sub> = Saldo Devedor<sub>k-1</sub> &times; i<br />
      Parcela<sub>k</sub> = Amortização + Juros<sub>k</sub>
    </p>

    <p>A taxa mensal é obtida a partir da taxa anual: <code>i = (1 + taxa_anual)<sup>1/12</sup> &minus; 1</code>.</p>
  </section>

  <aside class="disclaimer">
    <p>Esta calculadora tem fins educativos e informativos. Não constitui aconselhamento financeiro. Consulte seu banco para valores exatos.</p>
  </aside>

  <section class="relacionadas">
    <h2>Calculadoras Relacionadas</h2>
    <div class="cards-grid">
      <CalcCard
        nome="Juros Compostos"
        slug="juros-compostos"
        descricao="Calcule juros compostos com aportes mensais e veja a evolução do investimento."
        icone="📊"
        ativa={true}
      />
      <CalcCard
        nome="Rentabilidade Real"
        slug="rentabilidade-real"
        descricao="Descubra o rendimento real do seu investimento descontando a inflação."
        icone="📈"
        ativa={true}
      />
    </div>
  </section>
</CalculadoraLayout>

<script>
  function parseBRL(value: string): number {
    const cleaned = value.replace(/\./g, '').replace(',', '.').replace(/[^\d.\-]/g, '');
    const num = parseFloat(cleaned);
    return isNaN(num) ? NaN : num;
  }

  function formatBRL(value: number): string {
    return new Intl.NumberFormat('pt-BR', {
      style: 'currency',
      currency: 'BRL',
    }).format(value);
  }

  function clearErrors() {
    document.querySelectorAll('.erro').forEach((el) => (el.textContent = ''));
  }

  function showError(id: string, msg: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = msg;
  }

  function validate(): { valorFinanciado: number; taxaAnual: number; prazo: number; sistema: string } | null {
    clearErrors();
    let valid = true;

    const valorBem = parseBRL((document.getElementById('valor-bem') as HTMLInputElement).value);
    if (isNaN(valorBem) || valorBem <= 0) {
      showError('erro-valor-bem', 'Informe um valor do bem válido.');
      valid = false;
    }

    const entrada = parseBRL((document.getElementById('entrada') as HTMLInputElement).value);
    if (isNaN(entrada) || entrada < 0) {
      showError('erro-entrada', 'Informe um valor de entrada válido.');
      valid = false;
    }

    if (!isNaN(valorBem) && !isNaN(entrada) && entrada >= valorBem) {
      showError('erro-entrada', 'A entrada deve ser menor que o valor do bem.');
      valid = false;
    }

    const taxaAnual = parseBRL((document.getElementById('taxa-juros') as HTMLInputElement).value);
    if (isNaN(taxaAnual) || taxaAnual <= 0) {
      showError('erro-taxa-juros', 'Informe uma taxa de juros válida.');
      valid = false;
    }

    const prazo = parseInt((document.getElementById('prazo') as HTMLInputElement).value, 10);
    if (isNaN(prazo) || prazo < 1) {
      showError('erro-prazo', 'Informe um prazo de pelo menos 1 mês.');
      valid = false;
    }

    const sistema = (document.querySelector('input[name="sistema"]:checked') as HTMLInputElement).value;

    if (!valid) return null;

    const valorFinanciado = valorBem - entrada;
    return { valorFinanciado, taxaAnual, prazo, sistema };
  }

  interface ParcelaInfo {
    mes: number;
    amortizacao: number;
    juros: number;
    parcela: number;
    saldoDevedor: number;
  }

  function calcularPrice(pv: number, taxaAnual: number, n: number): ParcelaInfo[] {
    const i = Math.pow(1 + taxaAnual / 100, 1 / 12) - 1;
    const pmt = pv * (i * Math.pow(1 + i, n)) / (Math.pow(1 + i, n) - 1);
    const evolucao: ParcelaInfo[] = [];
    let saldo = pv;

    for (let mes = 1; mes <= n; mes++) {
      const juros = saldo * i;
      const amortizacao = pmt - juros;
      saldo = saldo - amortizacao;
      if (saldo < 0) saldo = 0;
      evolucao.push({
        mes,
        amortizacao: Math.round(amortizacao * 100) / 100,
        juros: Math.round(juros * 100) / 100,
        parcela: Math.round(pmt * 100) / 100,
        saldoDevedor: Math.round(saldo * 100) / 100,
      });
    }
    return evolucao;
  }

  function calcularSAC(pv: number, taxaAnual: number, n: number): ParcelaInfo[] {
    const i = Math.pow(1 + taxaAnual / 100, 1 / 12) - 1;
    const amortizacaoFixa = pv / n;
    const evolucao: ParcelaInfo[] = [];
    let saldo = pv;

    for (let mes = 1; mes <= n; mes++) {
      const juros = saldo * i;
      const parcela = amortizacaoFixa + juros;
      saldo = saldo - amortizacaoFixa;
      if (saldo < 0) saldo = 0;
      evolucao.push({
        mes,
        amortizacao: Math.round(amortizacaoFixa * 100) / 100,
        juros: Math.round(juros * 100) / 100,
        parcela: Math.round(parcela * 100) / 100,
        saldoDevedor: Math.round(saldo * 100) / 100,
      });
    }
    return evolucao;
  }

  function renderResultados(evolucao: ParcelaInfo[]) {
    const principal = document.getElementById('resultado-principal')!;
    const detalhes = document.getElementById('resultado-detalhes')!;
    const tabelaContainer = document.getElementById('tabela-evolucao')! as HTMLDetailsElement;
    const acoes = document.getElementById('acoes-resultado')!;

    const primeiraParcela = evolucao[0].parcela;
    const ultimaParcela = evolucao[evolucao.length - 1].parcela;
    const totalPago = evolucao.reduce((s, e) => s + e.parcela, 0);
    const totalJuros = evolucao.reduce((s, e) => s + e.juros, 0);

    document.getElementById('valor-primeira-parcela')!.textContent = formatBRL(primeiraParcela);
    document.getElementById('detalhe-primeira-parcela')!.textContent = formatBRL(primeiraParcela);
    document.getElementById('detalhe-ultima-parcela')!.textContent = formatBRL(ultimaParcela);
    document.getElementById('detalhe-total-pago')!.textContent = formatBRL(totalPago);
    document.getElementById('detalhe-total-juros')!.textContent = formatBRL(totalJuros);

    principal.style.display = '';
    detalhes.style.display = '';
    acoes.style.display = '';

    const tbody = document.querySelector('#tabela-mensal tbody')!;
    tbody.innerHTML = evolucao
      .map(
        (e) =>
          `<tr><td>${e.mes}</td><td>${formatBRL(e.amortizacao)}</td><td>${formatBRL(e.juros)}</td><td>${formatBRL(e.parcela)}</td><td>${formatBRL(e.saldoDevedor)}</td></tr>`
      )
      .join('');
    tabelaContainer.style.display = '';
  }

  document.getElementById('form-financiamento')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const params = validate();
    if (!params) return;

    const evolucao = params.sistema === 'price'
      ? calcularPrice(params.valorFinanciado, params.taxaAnual, params.prazo)
      : calcularSAC(params.valorFinanciado, params.taxaAnual, params.prazo);

    renderResultados(evolucao);
  });

  document.getElementById('btn-compartilhar')!.addEventListener('click', () => {
    const url = new URL(window.location.href.split('?')[0]);
    url.searchParams.set('vb', (document.getElementById('valor-bem') as HTMLInputElement).value);
    url.searchParams.set('en', (document.getElementById('entrada') as HTMLInputElement).value);
    url.searchParams.set('tj', (document.getElementById('taxa-juros') as HTMLInputElement).value);
    url.searchParams.set('pr', (document.getElementById('prazo') as HTMLInputElement).value);
    url.searchParams.set('si', (document.querySelector('input[name="sistema"]:checked') as HTMLInputElement).value);
    navigator.clipboard.writeText(url.toString()).then(() => {
      const btn = document.getElementById('btn-compartilhar')!;
      btn.textContent = 'Link copiado!';
      setTimeout(() => (btn.textContent = 'Compartilhar resultado'), 2000);
    });
  });

  document.getElementById('btn-imprimir')!.addEventListener('click', () => {
    window.print();
  });

  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const vb = params.get('vb');
    const en = params.get('en');
    const tj = params.get('tj');
    const pr = params.get('pr');
    const si = params.get('si');

    if (vb && en && tj && pr) {
      (document.getElementById('valor-bem') as HTMLInputElement).value = vb;
      (document.getElementById('entrada') as HTMLInputElement).value = en;
      (document.getElementById('taxa-juros') as HTMLInputElement).value = tj;
      (document.getElementById('prazo') as HTMLInputElement).value = pr;
      if (si === 'price') {
        (document.getElementById('sistema-price') as HTMLInputElement).checked = true;
      }

      const validated = validate();
      if (validated) {
        const evolucao = validated.sistema === 'price'
          ? calcularPrice(validated.valorFinanciado, validated.taxaAnual, validated.prazo)
          : calcularSAC(validated.valorFinanciado, validated.taxaAnual, validated.prazo);
        renderResultados(evolucao);
      }
    }
  });
</script>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .intro {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0 0 0.5rem;
  }

  .calc-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 2rem 0;
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-group label {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--text-primary);
  }

  .hint {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .form-group input[type="text"],
  .form-group input[type="number"] {
    background: var(--bg);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--text-primary);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-group input[type="text"]:focus,
  .form-group input[type="number"]:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .pill-toggle {
    display: inline-flex;
    border: 1.5px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
    background: var(--bg);
  }

  .pill-toggle input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .pill-toggle label {
    padding: 0.5rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    user-select: none;
  }

  .pill-toggle input[type="radio"]:checked + label {
    background: var(--accent);
    color: #fff;
  }

  .pill-toggle label:hover {
    background: var(--accent-soft);
  }

  .pill-toggle input[type="radio"]:checked + label:hover {
    background: var(--accent);
  }

  .erro {
    font-size: 0.75rem;
    color: var(--danger);
    min-height: 1rem;
  }

  .btn-primary {
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    padding: 0.875rem 2rem;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: var(--shadow-sm);
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .tabela-resumo {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.5rem;
  }

  .tabela-resumo td {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.875rem;
  }

  .tabela-resumo .label {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .tabela-resumo .tabela-valor {
    text-align: right;
    font-family: var(--font-mono);
    color: var(--text-primary);
    font-weight: 500;
  }

  #tabela-evolucao { margin: 1rem 0; }

  #tabela-evolucao summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--accent);
    padding: 0.5rem 0;
  }

  .tabela-scroll {
    overflow-x: auto;
    margin-top: 0.75rem;
  }

  #tabela-mensal {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }

  #tabela-mensal th {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid var(--border);
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  #tabela-mensal td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
  }

  #tabela-mensal tr:hover td {
    background: var(--accent-soft);
  }

  .acoes {
    display: flex;
    gap: 0.75rem;
    margin: 1.5rem 0;
    flex-wrap: wrap;
  }

  .btn-secondary {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 0.625rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .btn-secondary:hover {
    border-color: var(--accent-border);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .como-calculamos {
    margin: 3rem 0 2rem;
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .como-calculamos h2 {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }

  .como-calculamos h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 1.5rem 0 0.5rem;
  }

  .como-calculamos h3:first-of-type {
    margin-top: 0;
  }

  .como-calculamos p,
  .como-calculamos li {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .como-calculamos ul {
    padding-left: 1.25rem;
    margin: 0.75rem 0;
    list-style: disc;
  }

  .como-calculamos li { margin-bottom: 0.375rem; }

  .formula {
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    color: var(--accent);
    text-align: center;
    margin: 1rem 0;
  }

  .como-calculamos code {
    background: var(--accent-soft);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent);
  }

  .disclaimer {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin: 2rem 0;
  }

  .disclaimer p {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
  }

  .relacionadas { margin: 3rem 0 1rem; }

