---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, canonical, ogImage, ogType, jsonLd } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <Header />
    <main id="conteudo-principal">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
