---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  breadcrumbItems: Array<{ label: string; href?: string }>;
  autor?: string;
  atualizacao: string;
  fontes?: Array<{ nome: string; url: string }>;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, canonical, ogImage, breadcrumbItems, jsonLd } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumb items={breadcrumbItems} />
    <slot />
  </div>
</BaseLayout>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
</style>
