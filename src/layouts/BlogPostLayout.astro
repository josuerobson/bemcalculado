---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AutorBox from '../components/AutorBox.astro';

interface Props {
  title: string;
  description: string;
  date: string;
  updatedDate?: string;
  author: string;
  category: string;
  tags: string[];
  calculadora?: string;
  slug: string;
}

const { title, description, date, updatedDate, author, category, tags, calculadora, slug } = Astro.props;

const canonical = `https://bemcalculado.com.br/blog/${slug}/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: date,
    dateModified: updatedDate || date,
    author: { '@type': 'Person', name: author },
    publisher: {
      '@type': 'Organization',
      name: 'Bem Calculado',
      logo: { '@type': 'ImageObject', url: 'https://bemcalculado.com.br/favicon.svg' },
    },
    mainEntityOfPage: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://bemcalculado.com.br/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://bemcalculado.com.br/blog/' },
      { '@type': 'ListItem', position: 3, name: title },
    ],
  },
];
---

<BaseLayout
  title={`${title} — Bem Calculado`}
  description={description}
  canonical={canonical}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="blog-post">
    <Breadcrumb items={[
      { label: 'Início', href: '/' },
      { label: 'Blog', href: '/blog/' },
      { label: title }
    ]} />

    <header class="blog-post__header">
      <div class="blog-post__meta">
        <span class="blog-post__category">{category}</span>
        <time datetime={date}>{new Date(date).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
      </div>
      <h1>{title}</h1>
      <p class="blog-post__desc">{description}</p>
    </header>

    <div class="blog-post__content">
      <slot />
    </div>

    {calculadora && (
      <div class="blog-post__cta">
        <h3>Experimente a calculadora</h3>
        <p>Use nossa ferramenta gratuita para fazer seus próprios cálculos.</p>
        <a href={`/calculadoras/${calculadora}/`} class="btn-primary">
          Abrir calculadora
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    )}

    <div class="blog-post__tags">
      {tags.map((tag) => <span class="blog-post__tag">{tag}</span>)}
    </div>

    <AutorBox
      autor={author}
      atualizacao={new Date(updatedDate || date).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })}
    />
  </article>
</BaseLayout>

<style>
  .blog-post {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .blog-post__header {
    margin-bottom: 2rem;
  }

  .blog-post__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .blog-post__category {
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  h1 {
    font-size: 2.25rem;
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin: 0 0 0.75rem;
  }

  .blog-post__desc {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .blog-post__content {
    line-height: 1.8;
    color: var(--text-secondary);
    font-size: 1rem;
  }

  .blog-post__content :global(h2) {
    font-size: 1.5rem;
    margin: 2.5rem 0 0.75rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .blog-post__content :global(h3) {
    font-size: 1.15rem;
    margin: 2rem 0 0.5rem;
    color: var(--text-primary);
  }

  .blog-post__content :global(p) {
    margin: 0 0 1.25rem;
  }

  .blog-post__content :global(ul),
  .blog-post__content :global(ol) {
    padding-left: 1.5rem;
    margin: 0 0 1.25rem;
    list-style: disc;
  }

  .blog-post__content :global(ol) { list-style: decimal; }

  .blog-post__content :global(li) {
    margin-bottom: 0.4rem;
  }

  .blog-post__content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .blog-post__content :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }

  .blog-post__content :global(code) {
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .blog-post__content :global(blockquote) {
    border-left: 3px solid var(--accent);
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    background: var(--accent-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text-primary);
  }

  .blog-post__content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.875rem;
  }

  .blog-post__content :global(th),
  .blog-post__content :global(td) {
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--border);
    text-align: left;
  }

  .blog-post__content :global(th) {
    background: var(--surface);
    font-weight: 600;
    color: var(--text-primary);
  }

  .blog-post__cta {
    background: var(--accent-soft);
    border: 1.5px solid var(--accent-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin: 2rem 0;
    text-align: center;
  }

  .blog-post__cta h3 {
    font-size: 1.1rem;
    margin: 0 0 0.35rem;
    color: var(--text-primary);
  }

  .blog-post__cta p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0 0 1rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-primary:hover { background: var(--accent-hover); color: #fff; }

  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 2rem 0 1rem;
  }

  .blog-post__tag {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }
</style>
